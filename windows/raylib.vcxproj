<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{69AE195E-2FF5-44DB-8691-B9807CD47C68}</ProjectGuid>
    <RootNamespace>raylib</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="Build.props" />
  </ImportGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>PLATFORM_DESKTOP;GRAPHICS_API_OPENGL_33;_CRT_SECURE_NO_WARNINGS;_CRT_NONSTDC_NO_DEPRECATE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RaylibSource)\src\external\glfw\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(RaylibSource)\src\raudio.c" />
    <ClCompile Include="$(RaylibSource)\src\rcore.c" />
    <ClCompile Include="$(RaylibSource)\src\rmodels.c" />
    <ClCompile Include="$(RaylibSource)\src\rglfw.c" />
    <ClCompile Include="$(RaylibSource)\src\rshapes.c" />
    <ClCompile Include="$(RaylibSource)\src\rtext.c" />
    <ClCompile Include="$(RaylibSource)\src\rtextures.c" />
    <ClCompile Include="$(RaylibSource)\src\utils.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(RaylibSource)\src\raylib.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="ValidateRaylibSource" BeforeTargets="PrepareForBuild">
    <Exec Condition="'$(RaylibAutoRestore)'=='true'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)Restore-Raylib.ps1&quot; -Destination &quot;$(RaylibSource)&quot;" />
    <Error Condition="!Exists('$(RaylibSource)\src\raylib.h')" Text="raylib 5.5 was not found at '$(RaylibSource)'. If you configured RAYLIB_SOURCE or RaylibSource, point it at a complete source checkout or remove the override to use automatic setup." />
    <Error Condition="!Exists('$(RaylibSource)\src\external\glfw\include\GLFW\glfw3.h')" Text="The raylib source directory is incomplete: expected src\external\glfw\include\GLFW\glfw3.h." />
  </Target>
</Project>
