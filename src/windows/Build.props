<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)..\..\</ProjectRoot>
    <RaylibSource Condition="'$(RaylibSource)'=='' and '$(RAYLIB_SOURCE)'!=''">$(RAYLIB_SOURCE)</RaylibSource>
    <RaylibSource Condition="'$(RaylibSource)'=='' and Exists('$(USERPROFILE)\raylib-5.5\src\raylib.h')">$(USERPROFILE)\raylib-5.5</RaylibSource>
    <RaylibCacheRoot Condition="'$(RaylibCacheRoot)'==''">$(LOCALAPPDATA)\MazeGame\Dependencies</RaylibCacheRoot>
    <RaylibAutoRestore Condition="'$(RaylibAutoRestore)'=='' and '$(RaylibSource)'==''">true</RaylibAutoRestore>
    <RaylibSource Condition="'$(RaylibSource)'==''">$(RaylibCacheRoot)\raylib-5.5</RaylibSource>
    <OutDir>$(ProjectRoot)build-vs\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectRoot)build-vs\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
    <LocalDebuggerWorkingDirectory>$(ProjectRoot)</LocalDebuggerWorkingDirectory>
    <LocalDebuggerWorkingDirectory Condition="'$(NativeTest)'=='true'">$(OutDir)test-data\$(ProjectName)\</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(RaylibSource)\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies Condition="'$(UseRaylib)'=='true'">$(OutDir)raylib.lib;opengl32.lib;gdi32.lib;winmm.lib;user32.lib;shell32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <Target Name="PrepareTestDirectory" BeforeTargets="PrepareForBuild" Condition="'$(NativeTest)'=='true'">
    <MakeDir Directories="$(LocalDebuggerWorkingDirectory)" />
  </Target>
  <Target Name="CopyGameArtwork" AfterTargets="Build" Condition="'$(ProjectName)'=='MazeGame' or '$(ProjectName)'=='MazeGameTests'">
    <ItemGroup>
      <GameArtwork Include="$(ProjectRoot)src\assets\*.png" />
    </ItemGroup>
    <MakeDir Directories="$(OutDir)assets" />
    <Copy SourceFiles="@(GameArtwork)" DestinationFolder="$(OutDir)assets" SkipUnchangedFiles="true" />
  </Target>
</Project>
